<!-- Basic birth-death-sampling alignment simulation -->

<beast version="2.8" namespace="beast.base.spec.inference.parameter
                                :beast.base.spec.evolution.sitemodel
                                :beast.base.spec.evolution.substitutionmodel
                                :beast.base.inference
                                :remaster">

  <parameter id="kappa.s" spec="RealScalarParam" name="stateNode">2.0</parameter>
  <parameter id="freqParameter.s" spec="SimplexParam" dimension="4" name="stateNode">0.25</parameter>

  <run spec="Simulator" nSims="1">
    <simulate spec="feast.simulation.SimulatedAlignment"
	      outputFileName="$(filebase).nexus"
	      sequenceLength="1000">

      <siteModel spec="SiteModel" mutationRate="0.001">
        <substModel spec="HKY" kappa="@kappa.s">
          <frequencies spec="Frequencies" frequencies="@freqParameter.s"/>
        </substModel>
      </siteModel>
      <tree spec="SimulatedTree" id="tree">
	<trajectory spec="StochasticTrajectory" id="traj"
                    endsWhen="sample==10">
          <population spec="RealVectorParam" id="X" value="1"/>
          <samplePopulation spec="RealVectorParam" id="sample" value="0"/>

          <reaction spec="Reaction" rate="2"> X -> 2X </reaction>
          <reaction spec="Reaction" rate="1"> X -> 0 </reaction>
          <reaction spec="Reaction" rate="0.1"> X -> sample </reaction>
	</trajectory>
      </tree>
    </simulate>

    <logger spec="beast.base.inference.Logger" fileName="$(filebase).traj">
      <log idref="traj"/>
    </logger>
  </run>
</beast>

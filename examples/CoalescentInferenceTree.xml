<!-- Basic coalescent inference simulation study -->

<!-- Uses Remaster to simulate a tree under a coalescent model with
     constant population size 2.0, then uses BEAST to infer the population
     size from the tree. -->

<beast version="2.0"
       namespace="beast.base.spec.inference.parameter:remaster
                  :beast.base.spec.inference.distribution
                  :beast.base.spec.inference.operator
                  :beast.base.inference
                  :beast.base.evolution.tree
                  :beast.base.spec.evolution.tree
                  :beast.base.spec.evolution.tree.coalescent">


  <run spec="MCMC" chainLength="1000000">
    <state>
      <stateNode spec="RealScalarParam" id="inferredPopSize" value="1.0"/>
    </state>

    <distribution spec="CompoundDistribution">
      <distribution spec="coalescent.Coalescent">
        <treeIntervals spec="TreeIntervals">

          <!-- Simulated tree -->
          <tree id="tree" spec="SimulatedTree">
            <trajectory id="traj" spec="CoalescentTrajectory">
              <population id="pop" spec="ConstantPopulation" popSize="2.0"/>
              <reaction spec="PunctualReaction" n="100" times="0">0 -> pop</reaction>
            </trajectory>
          </tree>

        </treeIntervals>

        <populationModel spec="ConstantPopulation" popSize="@inferredPopSize"/>
      </distribution>

      <distribution spec="Exponential" mean="1.0" param="@inferredPopSize"/>
    </distribution>

    <operator spec="ScaleOperator" id="popSizeScaler" scaleFactor="0.8"
              parameter="@inferredPopSize" weight="1.0"/>

    <!-- File log -->
    <logger fileName="$(filebase).log" logEvery="100">
      <log idref="inferredPopSize"/>
    </logger>

    <!-- Screen log -->
    <logger logEvery="10000">
      <log idref="inferredPopSize"/>
    </logger>
    
  </run>
</beast>
